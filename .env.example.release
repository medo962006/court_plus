# Production Release Configuration
# Copy to .env and fill in real values before release build.
#
# For Android AAB release:
#   flutter build appbundle --dart-define=SUPABASE_URL=https://your-project.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key
#
# For iOS IPA release:
#   flutter build ipa --dart-define=SUPABASE_URL=https://your-project.supabase.co --dart-define=SUPABASE_ANON_KEY=your-anon-key

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps (REQUIRED for Explore screen)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# App Info
APP_VERSION=1.0.0
BUILD_NUMBER=1