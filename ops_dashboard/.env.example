# Copy to .env and fill in to connect the real Supabase backend.
# When left blank, the dashboard falls back to seeded stub data so the UI is
# fully usable for development and review.
#
# Get the URL + anon key from: Supabase → Project Settings → API
VITE_SUPABASE_URL=https://fnyekgsajrrihefqyaiq.supabase.co
VITE_SUPABASE_ANON_KEY=

# One-click admin sign-in (set to your dedicated ops admin; see create-admin Edge Function)
VITE_QUICK_ADMIN_EMAIL=
VITE_QUICK_ADMIN_PASSWORD=
